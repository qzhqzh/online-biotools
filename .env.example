DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
VEP_BIN=/opt/vep/src/ensembl-vep/vep
VEP_CACHE_DIR=./data/vep
VEP_ASSEMBLY=GRCh37
VEP_MODE=auto
VEP_DOCKER_IMAGE=ensemblorg/ensembl-vep:release_116.0
BIOTOOLS_API_KEYS=
BIOTOOLS_REQUIRE_API_KEY=0
BIOTOOLS_ANNOTATION_RATE=30/min
BIOTOOLS_JOB_COOLDOWN_SECONDS=10
ANNOVAR_MODE=auto
ANNOVAR_DB_DIR=./data/annovar/humandb
ANNOVAR_PUBLIC_ENABLED=0
# Compose overrides (optional):
# VEP_HOST_CACHE=./data/vep
# VEP_HOST_CACHE_GRCh37=./legacy/online-tool/online-vep/cache/homo_sapiens_merged/116_GRCh37
# ANNOVAR_HOST_DB=./data/annovar/humandb
