DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
VEP_BIN=/opt/vep/src/ensembl-vep/vep
VEP_CACHE_DIR=./data/vep
VEP_ASSEMBLY=GRCh37
BIOTOOLS_API_KEYS=
BIOTOOLS_REQUIRE_API_KEY=0
BIOTOOLS_ANNOTATION_RATE=30/min
ANNOVAR_MODE=auto
ANNOVAR_DB_DIR=./data/annovar-hg38
ANNOVAR_PUBLIC_ENABLED=0
# Compose overrides:
# VEP_HOST_CACHE=./legacy/online-tool/online-vep/cache
# ANNOVAR_HOST_DB=./legacy/online-annovar/humandb
